<Window x:Class="PowerCheck.App.DeviceEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Background="#F4F5F7">
    <StackPanel Margin="16">
        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,12"/>

        <TextBlock Text="What the label says (one number is enough)"/>
        <Grid Margin="0,4,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ValueBox" VerticalContentAlignment="Center" TextChanged="Value_Changed"/>
            <ComboBox x:Name="UnitBox" Grid.Column="1" Margin="6,0" Width="80" SelectedIndex="0" SelectionChanged="Value_Changed">
                <ComboBoxItem Content="watts"/>
                <ComboBoxItem Content="amps"/>
                <ComboBoxItem Content="VA"/>
            </ComboBox>
            <TextBlock x:Name="ConvertedText" Grid.Column="2" VerticalAlignment="Center" Foreground="#5F6670"/>
        </Grid>
        <TextBlock Foreground="#5F6670" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Use the input or &quot;rated&quot; number on the label, not the battery-side output of a charger."/>

        <TextBlock Text="Group"/>
        <ComboBox x:Name="CategoryBox" IsEditable="True" Margin="0,4,0,12"/>

        <CheckBox x:Name="ContinuousBox" Content="Runs for 3+ hours at a time (heaters, chargers, lights, fridges)" Margin="0,0,0,6"/>
        <CheckBox x:Name="MotorBox" Content="Has a motor (saws, vacuums, compressors, pumps)" Margin="0,0,0,6"/>
        <CheckBox x:Name="WallOnlyBox" Content="Manual says plug straight into a wall outlet" Margin="0,0,0,12"/>

        <TextBlock Text="Note (optional)"/>
        <TextBox x:Name="NoteBox" Margin="0,4,0,12" Height="54" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="Picture (optional)"/>
        <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="86" Height="86" Background="#EEF1F4" BorderBrush="#D8DCE2" BorderThickness="1"
                    HorizontalAlignment="Left">
                <Grid>
                    <TextBlock x:Name="NoPictureText" Text="No picture" Foreground="#7A828C" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="PicturePreview" Stretch="Uniform"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose file..." Padding="10,3" Margin="0,0,6,0" Click="ChoosePicture_Click"/>
                    <Button Content="Paste" Padding="10,3" Margin="0,0,6,0" Click="PastePicture_Click"
                            ToolTip="Paste a picture you copied (for example, right-click a product photo, Copy image)"/>
                    <Button Content="Remove" Padding="10,3" Click="RemovePicture_Click"/>
                </StackPanel>
                <TextBlock Foreground="#5F6670" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="A photo of the device or its label. It is copied into the app's device-images folder."/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Product link (optional)"/>
        <TextBox x:Name="LinkBox" Margin="0,4,0,2"/>
        <TextBlock Foreground="#5F6670" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Paste the web address of the product page. Leave blank to get an Amazon search for the name."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Padding="16,4" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </StackPanel>
</Window>
