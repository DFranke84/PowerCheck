<Window x:Class="PowerCheck.App.GearEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strip, hub or cord" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14" Background="#F4F5F7">
    <StackPanel Margin="16">
        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,12"/>

        <TextBlock Text="What is it?"/>
        <ComboBox x:Name="TypeBox" Margin="0,4,0,12" SelectionChanged="TypeBox_Changed"/>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Amp rating (from the tag)"/>
                <TextBox x:Name="AmpsBox" Margin="0,4,0,0" Text="15"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Number of outlets"/>
                <TextBox x:Name="OutletsBox" Margin="0,4,0,0" Text="1"/>
            </StackPanel>
        </Grid>
        <TextBlock Foreground="#5F6670" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Not on the tag? Use 13 for 16 gauge wire and 15 for 14 gauge or thicker."/>

        <Grid x:Name="CordFields" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wire gauge"/>
                <ComboBox x:Name="GaugeBox" Margin="0,4,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="Don't know"/>
                    <ComboBoxItem Content="16 gauge"/>
                    <ComboBoxItem Content="14 gauge"/>
                    <ComboBoxItem Content="12 gauge"/>
                    <ComboBoxItem Content="10 gauge"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Length (ft)"/>
                <TextBox x:Name="LengthBox" Margin="0,4,0,0" Text="0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Note (optional)"/>
        <TextBox x:Name="NoteBox" Margin="0,4,0,12" Height="54" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="Picture (optional)"/>
        <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="86" Height="86" Background="#EEF1F4" BorderBrush="#D8DCE2" BorderThickness="1" HorizontalAlignment="Left">
                <Grid>
                    <TextBlock x:Name="NoPictureText" Text="No picture" Foreground="#7A828C" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="PicturePreview" Stretch="Uniform"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose file..." Padding="10,3" Margin="0,0,6,0" Click="ChoosePicture_Click"/>
                    <Button Content="Paste" Padding="10,3" Margin="0,0,6,0" Click="PastePicture_Click"
                            ToolTip="Paste a picture you copied (right-click a product photo, Copy image)"/>
                    <Button Content="Remove" Padding="10,3" Click="RemovePicture_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Text="Product link (optional)"/>
        <TextBox x:Name="LinkBox" Margin="0,4,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Padding="16,4" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </StackPanel>
</Window>
