<Window x:Class="PowerCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerCheck.App"
        Title="PowerCheck" Height="760" Width="1220" MinHeight="600" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <local:DeviceLabelConverter x:Key="DeviceLabel"/>
        <DataTemplate x:Key="DevicePickerItem">
            <TextBlock Text="{Binding Converter={StaticResource DeviceLabel}}"/>
        </DataTemplate>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6670"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#E9ECF0" Padding="14,6">
            <TextBlock Style="{StaticResource Hint}"
                       Text="This is a guide, not a substitute for the device's manual. When in doubt, ask an electrician. Assumes US 120 V outlets and copper cords."/>
        </Border>

        <TabControl x:Name="Tabs" Margin="10" Padding="0">
            <TabItem x:Name="CordTab" Header="  Extension cord  ">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="480"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="1. What will you plug in?">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DevicePicker" ItemTemplate="{StaticResource DevicePickerItem}"
                                                  SelectionChanged="DevicePicker_SelectionChanged"/>
                                        <TextBox x:Name="QtyBox" Grid.Column="1" Width="40" Margin="6,0"
                                                 Text="1" TextAlignment="Center" VerticalContentAlignment="Center"
                                                 ToolTip="How many"/>
                                        <Button Grid.Column="2" Content="Add" Click="AddDevice_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="DeviceNote" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="New device..." Click="NewDevice_Click" Margin="0,0,6,0"/>
                                        <Button Content="Edit..." Click="EditDevice_Click" Margin="0,0,6,0"/>
                                        <Button x:Name="DeleteDeviceButton" Content="Delete" Click="DeleteDevice_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="Or type what the label says:" Margin="0,12,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="LabelValue" VerticalContentAlignment="Center"/>
                                        <ComboBox x:Name="LabelUnit" Grid.Column="1" Margin="6,0" Width="70" SelectedIndex="0">
                                            <ComboBoxItem Content="watts"/>
                                            <ComboBoxItem Content="amps"/>
                                            <ComboBoxItem Content="VA"/>
                                        </ComboBox>
                                        <CheckBox x:Name="LabelContinuous" Grid.Column="2" Content="Runs for hours"
                                                  VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="Add" Click="AddLabel_Click"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Labels show W (watts), A (amps) or VA. Treat VA like watts. Amps × 120 = watts."/>

                                    <ListView x:Name="ItemsList" Margin="0,12,0,0" MinHeight="150" MaxHeight="300"
                                              BorderBrush="#D8DCE2">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Device" Width="250" DisplayMemberBinding="{Binding Device.Name}"/>
                                                <GridViewColumn Header="Qty" Width="45" DisplayMemberBinding="{Binding Quantity}"/>
                                                <GridViewColumn Header="Watts" Width="65" DisplayMemberBinding="{Binding Watts, StringFormat={}{0:0}}"/>
                                                <GridViewColumn Width="85">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Remove" MinWidth="0" Padding="6,0" FontSize="12"
                                                                    Click="RemoveItem_Click" Tag="{Binding}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <TextBlock x:Name="TotalText" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="2. How long a cord?">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Len25" Content="25 ft" Margin="0,0,14,0" Checked="Input_Changed"/>
                                        <RadioButton x:Name="Len50" Content="50 ft" Margin="0,0,14,0" IsChecked="True" Checked="Input_Changed"/>
                                        <RadioButton x:Name="Len100" Content="100 ft" Margin="0,0,14,0" Checked="Input_Changed"/>
                                        <RadioButton x:Name="LenCustom" Content="Other:" Checked="Input_Changed"/>
                                        <TextBox x:Name="LenCustomBox" Width="50" Margin="6,0,4,0" Text="75"
                                                 TextChanged="Input_Changed"/>
                                        <TextBlock Text="ft" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Two cords plugged together count as their total length."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="3. Where?">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Indoor" Content="Indoors" Margin="0,0,20,0" IsChecked="True" Checked="Input_Changed"/>
                                    <RadioButton x:Name="Outdoor" Content="Outdoors / garage / damp" Checked="Input_Changed"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: answer -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="Banner" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="BannerTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BannerDetail" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <GroupBox Header="Every cord size, checked">
                                <ItemsControl x:Name="GaugeRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="16" Height="16" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Gauge}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Lengths}" Foreground="#5F6670" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="Good to know">
                                <ItemsControl x:Name="NotesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <BulletDecorator Margin="0,0,0,6">
                                                <BulletDecorator.Bullet>
                                                    <TextBlock Text="•  " FontWeight="Bold"/>
                                                </BulletDecorator.Bullet>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </BulletDecorator>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="LoadTab" Header="  Power strip / circuit  ">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="480"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: inputs -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Start from an example (optional)">
                                <WrapPanel>
                                    <Button Content="Garage chargers" Click="ExampleGarage_Click" Margin="0,0,6,4"
                                            ToolTip="DeWalt and Black+Decker maintainers plus the heated pet bed on one power strip"/>
                                    <Button Content="DeWalt workshop" Click="ExampleWorkshop_Click" Margin="0,0,6,4"
                                            ToolTip="Miter saw, shop vac, fast charger and work light on one 15 A circuit"/>
                                    <Button Content="Christmas lights" Click="ExampleLights_Click" Margin="0,0,6,4"
                                            ToolTip="Opens the lights helper with 4 big C9 strings on 100 ft"/>
                                    <Button Content="Clear" Click="LoadClear_Click" Margin="0,0,0,4"/>
                                </WrapPanel>
                            </GroupBox>

                            <GroupBox Header="1. What is everything plugged into?">
                                <StackPanel>
                                    <RadioButton x:Name="SrcStrip" Content="A power strip (15 A)" IsChecked="True" Checked="Load_Changed" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <RadioButton x:Name="SrcCord" Content="An extension cord:" Checked="Load_Changed" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="SrcCordGauge" Width="120" Margin="8,0,0,0" SelectionChanged="Load_Changed"/>
                                    </StackPanel>
                                    <RadioButton x:Name="SrcCircuit15" Content="A wall circuit with a 15 A breaker (most outlets)" Checked="Load_Changed" Margin="0,0,0,4"/>
                                    <RadioButton x:Name="SrcCircuit20" Content="A wall circuit with a 20 A breaker (kitchen, garage, shop)" Checked="Load_Changed"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="SrcGear" Content="One of mine:" Checked="Load_Changed" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="GearPick" Grid.Column="1" Margin="8,0" SelectionChanged="GearPick_Changed"/>
                                        <Button Grid.Column="2" Width="40" Height="40" Padding="0" MinWidth="0" Click="GearPicture_Click"
                                                Background="#EEF1F4" BorderBrush="#D8DCE2" ToolTip="Click to see it bigger">
                                            <Grid>
                                                <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Symbol" Foreground="#7A828C" FontSize="18"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="GearThumb" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="GearNote" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="New strip / cord..." Click="GearNew_Click" Margin="0,0,6,0"/>
                                        <Button Content="Edit..." Click="GearEdit_Click" Margin="0,0,6,0"/>
                                        <Button x:Name="GearDeleteButton" Content="Delete" Click="GearDelete_Click" Margin="0,0,6,0"/>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}">
                                            <Hyperlink x:Name="GearLink" RequestNavigate="ShopLink_RequestNavigate">Product page</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="The breaker's number is printed on its switch in the breaker panel."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="2. What's plugged in?">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="LoadPicker" ItemTemplate="{StaticResource DevicePickerItem}"/>
                                        <TextBox x:Name="LoadQty" Grid.Column="1" Width="40" Margin="6,0" Text="1"
                                                 TextAlignment="Center" VerticalContentAlignment="Center" ToolTip="How many"/>
                                        <Button Grid.Column="2" Content="Add" Click="LoadAdd_Click"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Starred favorites are at the top of the list. Untick &quot;On together&quot; for things that never run at the same time."/>

                                    <ListView x:Name="LoadItems" Margin="0,10,0,0" MinHeight="150" MaxHeight="320" BorderBrush="#D8DCE2">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Device" Width="230" DisplayMemberBinding="{Binding Device.Name}"/>
                                                <GridViewColumn Header="Qty" Width="52">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="36"
                                                                     TextAlignment="Center"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Header="Watts" Width="62" DisplayMemberBinding="{Binding Watts, StringFormat={}{0:0}}"/>
                                                <GridViewColumn Header="On together" Width="82">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding OnAtSameTime}" HorizontalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="80">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Remove" MinWidth="0" Padding="6,0" FontSize="12"
                                                                    Click="LoadRemove_Click" Tag="{Binding}"/>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                            </GroupBox>

                            <Expander x:Name="LightsExpander" Header="Christmas lights: how many strings can I chain?" Margin="0,0,0,12"
                                      Background="White" BorderBrush="#D8DCE2" Padding="10">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Type of string:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <ComboBox x:Name="LightType" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="LightType_Changed"/>
                                        <TextBlock Grid.Row="1" Text="Watts per string:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <TextBox x:Name="LightWatts" Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Margin="0,0,0,6" TextChanged="Light_Changed"/>
                                        <TextBlock Grid.Row="2" Text="How many strings:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <TextBox x:Name="LightCount" Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Margin="0,0,0,6" Text="10" TextChanged="Light_Changed"/>
                                        <TextBlock Grid.Row="3" Text="Tag says connect up to:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBox x:Name="LightMax" Width="70" TextChanged="Light_Changed"/>
                                            <TextBlock Text="strings end to end" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Text="Extension cord length:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="LightFeet" Width="70" Text="50" TextChanged="Light_Changed"/>
                                            <TextBlock Text="ft (outdoors)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="LightBanner" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LightChainText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LightCordText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="The &quot;connect up to&quot; number is on the tag near the plug. If you mix brands, use the smallest number."/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right: answer -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="LoadBanner" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="LoadTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LoadDetail" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <GroupBox Header="How full is it?">
                                <StackPanel>
                                    <ProgressBar x:Name="LoadBar" Height="26" Minimum="0" Maximum="125" Background="#EEF1F4"/>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64*"/>
                                            <ColumnDefinition Width="16*"/>
                                            <ColumnDefinition Width="20*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="0" Style="{StaticResource Hint}"/>
                                        <Border Grid.Column="1" BorderBrush="#F2A900" BorderThickness="2,0,0,0">
                                            <TextBlock Text=" 80 %" Style="{StaticResource Hint}"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="#C62828" BorderThickness="2,0,0,0">
                                            <TextBlock Text=" 100 % limit" Style="{StaticResource Hint}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="LoadNumbers" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Good to know">
                                <ItemsControl x:Name="LoadNotes">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <BulletDecorator Margin="0,0,0,6">
                                                <BulletDecorator.Bullet>
                                                    <TextBlock Text="•  " FontWeight="Bold"/>
                                                </BulletDecorator.Bullet>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </BulletDecorator>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="DevicesTab" Header="  Devices  ">
                <DockPanel Margin="14">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DeviceSearch" Grid.Column="1" VerticalContentAlignment="Center"
                                 TextChanged="DeviceFilter_Changed"/>
                        <TextBlock Grid.Column="2" Text="Group:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="GroupFilter" Grid.Column="3" SelectionChanged="DeviceFilter_Changed"/>
                        <TextBlock x:Name="DeviceCount" Grid.Column="4" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Style="{StaticResource Hint}"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <Button Content="Use on cord" Click="UseOnCord_Click" Margin="0,0,6,0"
                                    ToolTip="Add the selected device to the Extension cord tab"/>
                            <Button Content="New device..." Click="NewDevice_Click" Margin="0,0,6,0"/>
                            <Button Content="Edit..." Click="ListEdit_Click" Margin="0,0,6,0"/>
                            <Button x:Name="ListDeleteButton" Content="Delete" Click="ListDelete_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Double-click a device to edit it. Click a picture to see it bigger. Watts are typical values: your device's label is always the real answer."/>

                    <ListView x:Name="DeviceTable" BorderBrush="#D8DCE2"
                              SelectionChanged="DeviceTable_SelectionChanged"
                              MouseDoubleClick="DeviceTable_MouseDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                                <Setter Property="Padding" Value="2,4"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Fav" Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Star}" Foreground="{Binding StarBrush}" Click="Star_Click"
                                                    Tag="{Binding}" FontSize="20" MinWidth="0" Padding="2,0" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0" ToolTip="{Binding StarTip}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Picture" Width="78">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="Thumb_Click" Tag="{Binding}" Width="60" Height="60" Padding="0"
                                                    MinWidth="0" Background="#EEF1F4" BorderBrush="#D8DCE2" Cursor="Hand"
                                                    ToolTip="{Binding ThumbTip}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Icon}" FontSize="26" Foreground="#7A828C"
                                                               FontFamily="Segoe UI Symbol"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Device" Width="330">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="315">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Group" Width="150" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Watts" Width="65" DisplayMemberBinding="{Binding Watts, StringFormat={}{0:0}}"/>
                                <GridViewColumn Header="Amps" Width="60" DisplayMemberBinding="{Binding Amps, StringFormat={}{0:0.0}}"/>
                                <GridViewColumn Header="Good to know" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Flags}" TextWrapping="Wrap" Width="140" FontSize="12.5"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="From" Width="70" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="Shop" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="ShopLink_RequestNavigate"
                                                           ToolTip="{Binding Url}">
                                                    <Run Text="{Binding LinkText, Mode=OneWay}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="  Learn (next)  " IsEnabled="False"/>
        </TabControl>
    </DockPanel>
</Window>
